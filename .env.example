# --- دیتابیس (اختیاری) ---
# اگر خالی بماند، پروژه با فایل JSON محلی (.data/db.json) و داده‌ی نمونه کار می‌کند.
# برای PostgreSQL مقدار زیر را تنظیم کنید
DATABASE_URL=

# --- ورود ادمین ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# یک رشته‌ی تصادفی طولانی (حداقل ۳۲ کاراکتر) برای امضای نشست
AUTH_SECRET=replace-with-a-long-random-string-32-chars-min

# --- سایت ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- همگام‌سازی خودروها از Dubicars (اختیاری) ---
# آدرس صفحه‌ی جست‌وجوی موردنظر شما (پیش‌فرض: جست‌وجوی used با ارز AED)
#DUBICARS_SEARCH_URL=https://www.dubicars.com/search?c=used&cr=AED&ul=DE&l=3
# حداکثر صفحه در هر دسته‌ی همگام‌سازی (هر صفحه ۳۰ آگهی)؛ ۰ یا خالی = تا پایان بودجه/چرخه (پیش‌فرض ۰)
#DUBICARS_PAGES=0
# بودجه‌ی زمانی هر دسته به میلی‌ثانیه؛ حداکثر ۱۸۰۰۰۰ (پیش‌فرض ۱۵۰۰۰۰)
#DUBICARS_TIME_BUDGET_MS=150000
# مکث بین درخواست‌های صفحه به میلی‌ثانیه؛ کمتر از ~۲۰۰۰ باعث مسدودشدن Cloudflare می‌شود (پیش‌فرض ۲۵۰۰)
#DUBICARS_PAGE_DELAY_MS=2500
# تعداد تصاویر هر خودرو که دانلود می‌شود (پیش‌فرض ۴)
#DUBICARS_IMAGES=4
# فاصله‌ی همگام‌سازی خودکار برای listings:worker به دقیقه (پیش‌فرض ۱۰)
#SYNC_INTERVAL_MINUTES=10

# =====================================================================
# --- نرخ درهم (زنده) ---
# =====================================================================
# سرور خودش هر N ثانیه نرخ را از چند منبع می‌گیرد (۱۰ تا ۳۶۰۰؛ پیش‌فرض ۳۰). نرخ «دستی» ادمین هرگز بازنویسی نمی‌شود.
#RATE_INTERVAL_SECONDS=30
# منبع اضافه بدون تغییر کد؛ divisor=10 یعنی مقدار منبع ریال است، 1 یعنی تومان:
#RATE_SOURCES_EXTRA=[{"name":"mysrc","url":"https://example.com/api","path":"data.aed.sell","divisor":10}]
# رمز برای کرون خارجی /api/exchange-rate/update (حداقل ۱۶ کاراکتر؛ فقط اگر پردازش پس‌زمینه ندارید)
#CRON_SECRET=
# خاموش‌کردن کارهای پس‌زمینه‌ی داخل سرور (پیش‌فرض روشن در production)
#AUTO_JOBS=false

# =====================================================================
# --- ورود آگهی‌ها: collector خارجی (روش پیشنهادی) ---
# =====================================================================
# توکن /api/ingest (حداقل ۱۶ کاراکتر). همین مقدار را هنگام اجرای scripts/collector.mjs هم بدهید.
#INGEST_TOKEN=
# همگام‌سازی سمت خودِ سرور (فقط اگر IP سرور مسدود نیست):
#AUTO_SYNC=true
#DUBICARS_FAST_EVERY_MINUTES=5
#DUBICARS_FAST_PAGES=2
#DUBICARS_CYCLE_REST_MINUTES=30
# فیلتر «سال از ۲۰۲۳» روی خودِ Dubicars (کاهش چشمگیر تعداد صفحه‌ها)؛ برای خاموش‌کردن: false
#DUBICARS_YEAR_FILTER=true

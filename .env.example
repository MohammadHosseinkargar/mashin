# --- دیتابیس (اختیاری) ---
# اگر خالی بماند، پروژه با فایل JSON محلی (.data/db.json) و داده‌ی نمونه کار می‌کند.
# برای PostgreSQL مقدار زیر را تنظیم کنید
DATABASE_URL=

# --- ورود ادمین ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# یک رشته‌ی تصادفی طولانی (حداقل ۳۲ کاراکتر) برای امضای نشست
AUTH_SECRET=replace-with-a-long-random-string-32-chars-min

# --- سایت ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- همگام‌سازی خودروها از Dubicars (اختیاری) ---
# آدرس صفحه‌ی جست‌وجوی موردنظر شما (پیش‌فرض: جست‌وجوی used با ارز AED)
#DUBICARS_SEARCH_URL=https://www.dubicars.com/search?c=used&cr=AED&ul=DE&l=3
# حداکثر صفحه در هر دسته‌ی همگام‌سازی (هر صفحه ۳۰ آگهی)؛ ۰ یا خالی = تا پایان بودجه/چرخه (پیش‌فرض ۰)
#DUBICARS_PAGES=0
# بودجه‌ی زمانی هر دسته به میلی‌ثانیه؛ حداکثر ۱۸۰۰۰۰ (پیش‌فرض ۱۵۰۰۰۰)
#DUBICARS_TIME_BUDGET_MS=150000
# مکث بین درخواست‌های صفحه به میلی‌ثانیه؛ کمتر از ~۲۰۰۰ باعث مسدودشدن Cloudflare می‌شود (پیش‌فرض ۲۵۰۰)
#DUBICARS_PAGE_DELAY_MS=2500
# تعداد تصاویر هر خودرو که دانلود می‌شود (پیش‌فرض ۴)
#DUBICARS_IMAGES=4
# فاصله‌ی همگام‌سازی خودکار برای listings:worker به دقیقه (پیش‌فرض ۱۰)
#SYNC_INTERVAL_MINUTES=10

# --- دیتابیس (اختیاری) ---
# اگر خالی بماند، پروژه با فایل JSON محلی (.data/db.json) و داده‌ی نمونه کار می‌کند.
# برای PostgreSQL مقدار زیر را تنظیم کنید و سپس: npm run db:setup
DATABASE_URL=

# --- ورود ادمین ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# یک رشته‌ی تصادفی طولانی (حداقل ۳۲ کاراکتر) برای امضای نشست
AUTH_SECRET=replace-with-a-long-random-string-32-chars-min

# --- سایت ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

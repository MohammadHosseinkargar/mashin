"use strict";
const pg = require("pg");
const { Client } = pg;

const DSN = process.env.DATABASE_URL;
if (!DSN) {
  console.error("[vehicle-health] DATABASE_URL is required.");
  process.exit(2);
}

const INTERVAL = Math.max(10000, Number(process.env.HEALTH_INTERVAL_SECONDS || 60)) * 1000;
const CONFIRMATION_RUNS = Math.max(1, Number(process.env.HEALTH_CONFIRMATION_RUNS || 2));
const CHECK_TIMEOUT_MS = Math.max(1000, Number(process.env.HEALTH_CHECK_TIMEOUT_MS || 15000));
const LIMIT_PER_TICK = Math.max(1, Number(process.env.HEALTH_LIMIT_PER_TICK || 1000));

/*
  Vehicle health checker

  This worker is the long-running monitor that you asked for. It does not
  download or cache vehicle images for display; it only uses the image URLs
  already stored in the database as part of each vehicle record, both to know
  what to monitor and as an optional fallback probe.

  Images are never downloaded to this server. The frontend already renders
  vehicle images directly from the stored URLs (see vehicle-gallery.tsx,
  vehicle-card.tsx and the site API), so there is no local image cache to
  upload or serve.
*/

const SOURCE_META = new Map([
  [
    "dubicars", {
      name: "dubicars",
      buildUrl(externalId) {
        return `https://www.dubicars.com/used-cars-for-sale/${externalId}.html`;
      }
    }
  ]
]);

function hasExternalRef(specifications) {
  if (!specifications || typeof specifications !== "object") return null;
  if (Array.isArray(specifications) || specifications === null) return null;
  const sid = specifications.externalSourceId;
  const sname = specifications.externalSource;
  if (sid === undefined && sname === undefined) return null;
  const source =
    typeof sname === "string" && sname.trim().length
      ? String(sname).trim().toLowerCase()
      : null;
  const id =
    typeof sid === "string" && sid.trim().length ? String(sid).trim() : null;
  if (!source) return null;
  if (!SOURCE_META.has(source) && !id) return { source, id: null };
  if (!id) return null;
  return { source, id };
}

function now() {
  return new Date().toISOString().replace("T", " ").slice(0, 19);
}

function log(message, detail) {
  const line = `[vehicle-health][${now()}] ${message}`;
  if (detail) console.log(line, detail);
  else console.log(line);
}



// ---- http helpers ----
async function fetchPage(url) {
  return new Promise((resolve) => {
    const controller = new AbortController();
    const timer = setTimeout(
      () => { try { controller.abort(); } catch (e) {} },
      CHECK_TIMEOUT_MS
    );
    const signal = controller.signal;
    const http = require("http");
    const https = require("https");
    const parsed = new URL(url);
    const transport = parsed.protocol === "https:" ? https : http;
    const chunks = [];
    let settled = false;

    const req = transport.request(parsed, {
      method: "GET",
      signal,
      headers: {
        "User-Agent":
          "VehicleHealthChecker/1.0 (automotive inventory monitor)",
        "Accept":
          "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "Accept-Language":
          "en-US,en;q=0.9,fa-IR;q=0.8,fa;q=0.7",
        "Cache-Control": "no-cache",
        "Pragma": "no-cache",
      },
    }, (res) => {
      try { clearTimeout(timer); } catch (e) {}
      res.on("data", (chunk) => { chunks.push(chunk); });
      res.on("end", () => {
        try {
          const status = res.statusCode;
          const body = Buffer.concat(chunks).toString("utf8");
          resolve({ status, body, lowercasedBody: body.toLowerCase() });
        } catch (e) {
          resolve(null);
        }
      });
    });
    req.on("error", (error) => {
      try { clearTimeout(timer); } catch (e) {}
      if (!settled) {
        settled = true;
        resolve(null);
      }
    });
    req.on("close", () => {
      try { clearTimeout(timer); } catch (e) {}
    });
    req.end();
    setTimeout(() => {
      if (!settled) {
        settled = true;
        try { controller.abort(); } catch (e) {}
        resolve(null);
      }
    }, CHECK_TIMEOUT_MS + 500);
  });
}
async function fetchHead(url) {
  return new Promise((resolve) => {
    const controller = new AbortController();
    const timer = setTimeout(
      () => { try { controller.abort(); } catch (e) {} },
      CHECK_TIMEOUT_MS
    );
    const signal = controller.signal;
    const http = require("http");
    const https = require("https");
    const parsed = new URL(url);
    const transport = parsed.protocol === "https:" ? https : http;
    let settled = false;

    const req = transport.request(parsed, {
      method: "HEAD",
      signal,
      headers: {
        "User-Agent":
          "VehicleHealthChecker/1.0 (automotive inventory monitor)",
        "Accept": "*/*",
        "Cache-Control": "no-cache",
      },
    }, (res) => {
      try { clearTimeout(timer); } catch (e) {}
      if (!settled) {
        settled = true;
        resolve({ status: res.statusCode });
      }
    });
    req.on("error", (error) => {
      try { clearTimeout(timer); } catch (e) {}
      if (!settled) {
        settled = true;
        resolve(null);
      }
    });
    req.on("close", () => {
      try { clearTimeout(timer); } catch (e) {}
    });
    req.end();
    setTimeout(() => {
      if (!settled) {
        settled = true;
        try { controller.abort(); } catch (e) {}
        resolve(null);
      }
    }, CHECK_TIMEOUT_MS + 500);
  });
}

async function probeListing(sourceName, externalId) {
  const meta = SOURCE_META.get(sourceName);
  if (!meta) return { ok: false, result: null, reason: "unsupported source" };
  const url = meta.buildUrl(externalId);
  let currentUrl = url;
  let redirectCount = 0;
  const maxRedirects = 3;

  while (true) {
    if (redirectCount > maxRedirects) {
      return { ok: true, result: null, reason: "too many redirects" };
    }
    const page = await fetchPage(currentUrl);
    if (!page) {
      return { ok: true, result: null, reason: "listing fetch failed or timed out" };
    }
    const { status, lowercasedBody } = page;
    if (status === 403 || status === 429) {
      return { ok: true, result: null, reason: `listing blocked status ${status}` };
    }
    if (status === 404) {
      return { ok: true, result: false, reason: `listing status ${status}` };
    }
    if (status >= 300 && status < 400) {
      const location = page.headers && page.headers.location;
      if (location) {
        redirectCount += 1;
        currentUrl = new URL(location, currentUrl).href;
        continue;
      }
    }
    if (status >= 200 && status < 400) {
      const removed =
        lowercasedBody.includes("not found") ||
        lowercasedBody.includes("listing is no longer available") ||
        lowercasedBody.includes("this listing is no longer available") ||
        lowercasedBody.includes("not available") ||
        lowercasedBody.includes("معرفی نمی‌شود") ||
        lowercasedBody.includes("لیست dı");
      return {
        ok: true,
        result: !removed ? true : false,
        reason: `listing status ${status}`,
      };
    }
    return { ok: true, result: null, reason: `unexpected listing status ${status}` };
  }
}

async function probeImage(sourceName, imageUrl) {
  if (!imageUrl || typeof imageUrl !== "string") return null;
  const trimmed = imageUrl.trim();
  if (!trimmed) return null;
  if (!trimmed.startsWith("http://") && !trimmed.startsWith("https://")) return null;
  const head = await fetchHead(trimmed);
  if (!head) return null;
  if (head.status === 403 || head.status === 429) return null;
  if (head.status === 404) return false;
  if (head.status >= 200 && head.status < 400) return true;
  return null;
}

async function externalExists(externalId, source, imageUrl) {
  const listing = await probeListing(source, externalId);
  if (!listing.ok) return listing;
  if (listing.result !== null) return listing;

  if (!imageUrl) return listing;

  const image = await probeImage(source, imageUrl);
  if (image === null) return listing;
  return { ok: true, result: image, reason: `image status ${image ? "reachable" : "removed"}, listing inconclusive` };
}

async function checkVehicle(client, vehicle) {
  const ref = hasExternalRef(vehicle.specifications);
  if (!ref) return { vehicle, result: null, reason: "no source ref" };
  const { source, id } = ref;
  if (!id) return { vehicle, result: null, reason: "no external id" };
  const probe = await probeExist(source, id);
  if (!probe.ok) {
    log(`unsupported source for externalId=${id}`, source);
    return { vehicle, result: null, reason: probe.reason };
  }
  if (probe.result === null) {
    log(`inconclusive for externalId=${id}`, `${source} -> ${probe.reason}`);
    return { vehicle, result: null, reason: probe.reason };
  }
  log(`externalId=${id} result=${probe.result}`, `${source} -> ${probe.reason}`);
  return { vehicle, result: probe.result, reason: probe.reason };
}

const RECENT = new Map();
function markRecent(key) {
  RECENT.set(key, Date.now());
}
function isRecent(key) {
  const t = RECENT.get(key);
  if (!t) return false;
  return Date.now() - t < INTERVAL;
}

async function runTick(client) {
  const sql = `
    SELECT id, brand, model, images, specifications, status
    FROM vehicles
    WHERE status <> 'unavailable'
      AND specifications IS NOT NULL
      AND specifications::text <> '{}'
    ORDER BY id
    LIMIT $1
  `;
  const { rows } = await client.query(sql, [LIMIT_PER_TICK]);
  let changed = 0;
  for (const row of rows) {
    const v = row;
    const ref = hasExternalRef(v.specifications);
    if (!ref || !ref.id) continue;
    if (v.status === "unavailable") continue;
    const key = `${ref.source}:${ref.id}`;
    if (isRecent(key)) continue;

    const check = await checkVehicle(client, v);
    const outcome = check.result;

    if (outcome === true) {
      markRecent(key);
      continue;
    }
    if (outcome === null) {
      continue;
    }

    const stateKey = `${key}:state`;
    const existing = await client.query(
      "SELECT value FROM kv WHERE key=$1",
      [stateKey]
    );
    let runs = parseInt(existing.rows[0]?.value || "0", 10);
    runs += 1;
    await client.query(
      `INSERT INTO kv(key,value) VALUES($1,$2)
       ON CONFLICT(key) DO UPDATE SET value=EXCLUDED.value`,
      [stateKey, String(runs)]
    );

    if (runs >= CONFIRMATION_RUNS) {
      log(
        `marking externalId=${ref.id} unavailable after ${runs} absence checks`,
        ref.source
      );
      await client.query(
        `UPDATE vehicles
         SET status=$1, updatedAt=now()
         WHERE id=$2 AND status <> 'unavailable'`,
        ["unavailable", v.id]
      );
      RECENT.delete(key);
      await client.query("DELETE FROM kv WHERE key=$1", [stateKey]);
      changed += 1;
    } else {
      markRecent(key);
    }
  }
  return changed;
}

async function ensureKvTable(client) {
  try {
    await client.query(
      `CREATE TABLE IF NOT EXISTS kv (
        key text PRIMARY KEY,
        value text NOT NULL
      )`
    );
  } catch (error) {
    log("kv table setup failed", error && error.message);
  }
}

async function main() {
  const client = new Client({
    connectionString: DSN,
    application_name: "vehicle-health",
  });
  try {
    await client.connect();
  } catch (error) {
    console.error(
      "[vehicle-health] cannot connect to postgres",
      error && error.message
    );
    process.exit(2);
  }
  await ensureKvTable(client);

  const once = process.argv.includes("--once");
  log(
    `worker started once=${once} interval=${INTERVAL} confirmationRuns=${CONFIRMATION_RUNS}`
  );

  async function tick() {
    try {
      const changed = await runTick(client);
      log(`tick finished changed=${changed} pending=${RECENT.size}`);
    } catch (error) {
      log("tick failed", error && error.message);
    }
  }

  await tick();
  if (once) {
    log("once mode finished");
    process.exit(0);
  }

  setInterval(tick, INTERVAL).unref();
  log("scheduled ticks");
}

main().catch((error) => {
  console.error("[vehicle-health] fatal", error && error.message);
  process.exit(2);
});
